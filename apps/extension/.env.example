# Copy to `.env` and fill in. All WXT_* vars are inlined at build time.

# Clerk publishable key — same instance the web app uses.
WXT_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Clerk Frontend API host, no trailing slash (Clerk dashboard → API keys → Frontend API).
WXT_CLERK_FRONTEND_API=https://xxx.clerk.accounts.dev

# The web app the extension borrows its session from, no trailing slash.
WXT_WEB_ORIGIN=https://isotope-web-staging.hatiprithwish.workers.dev

# The Hono API the extension posts captures to, no trailing slash.
WXT_API_ORIGIN=https://isotope-worker-staging.hatiprithwish.workers.dev

# Base64 public key that pins the CRX ID. Generate with:
#   openssl genrsa 2048 | openssl pkcs8 -topk8 -nocrypt -out key.pem
#   openssl rsa -in key.pem -pubout -outform DER | base64 | tr -d '\n'
# (`base64 -w 0` is GNU-only and fails on macOS — `tr -d '\n'` works on both.)
# Keep key.pem out of git; only the public key belongs here.
WXT_CRX_PUBLIC_KEY=
