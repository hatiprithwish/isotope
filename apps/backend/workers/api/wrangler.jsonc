{
  "name": "isotope-worker",
  "main": "index.ts",
  // DEV_NOTE: keep it up to date with the current date.
  "compatibility_date": "2026-05-22",
  // DEV_NOTE: nodejs_compat flag is needed for using AsyncLocalStorage.
  "compatibility_flags": ["nodejs_compat"],
  "env": {
    "staging": {
      "name": "isotope-worker-staging",
      "vars": {
        "ALLOWED_CORS_ORIGIN": "http://localhost:3000,https://isotope-web-staging.hatiprithwish.workers.dev"
      },
      "ai": {
        "binding": "AI",
        "remote": true
      },
      "workflows": [
        {
          "name": "job-discovery",
          "binding": "JOB_DISCOVERY_WORKFLOW",
          "class_name": "JobDiscoveryWorkflow"
        }
      ],
      "queues": {
        "producers": [
          {
            "queue": "isotope-queue",
            "binding": "ISOTOPE_QUEUE"
          }
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "isotope-db",
          "database_id": "ade49f6b-b66a-4f50-9cf0-2f32f8974a6f",
          "migrations_dir": "../../src/db/migrations",
          "remote": true
        }
      ],
      "observability": {
        "enabled": false,
        "head_sampling_rate": 1,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "persist": true,
          "invocation_logs": true
        },
        "traces": {
          "enabled": true,
          "persist": true,
          "head_sampling_rate": 1
        }
      }
    },
    "production": {
      "name": "isotope-worker",
      "vars": {
        "ALLOWED_CORS_ORIGIN": "https://isotope-web.hatiprithwish.workers.dev"
      },
      "ai": {
        "binding": "AI",
        "remote": true
      },
      "workflows": [
        {
          "name": "job-discovery",
          "binding": "JOB_DISCOVERY_WORKFLOW",
          "class_name": "JobDiscoveryWorkflow"
        }
      ],
      "queues": {
        "producers": [
          {
            "queue": "isotope-queue",
            "binding": "ISOTOPE_QUEUE"
          }
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "isotope-db",
          "database_id": "ade49f6b-b66a-4f50-9cf0-2f32f8974a6f",
          "migrations_dir": "../../src/db/migrations",
          "remote": true
        }
      ],
      "observability": {
        "enabled": false,
        "head_sampling_rate": 1,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "persist": true,
          "invocation_logs": true
        },
        "traces": {
          "enabled": true,
          "persist": true,
          "head_sampling_rate": 1
        }
      }
    }
  }
}
