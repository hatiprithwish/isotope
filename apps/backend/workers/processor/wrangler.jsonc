{
  "name": "isotope-processor",
  "main": "index.ts",
  // DEV_NOTE: keep it up to date with the current date.
  "compatibility_date": "2026-05-22",
  // DEV_NOTE: nodejs_compat flag is needed for using AsyncLocalStorage.
  "compatibility_flags": ["nodejs_compat"],
  // DEV_NOTE: Empty consumers at base level — prevents Cloudflare from inheriting
  // base queue bindings into env-specific deployments.
  "queues": {
    "consumers": []
  },
  "env": {
    "staging": {
      "name": "isotope-processor-staging",
      "queues": {
        "consumers": [
          {
            "queue": "isotope-queue-staging",
            "max_batch_size": 10,
            "max_batch_timeout": 30,
            "max_retries": 3,
            "dead_letter_queue": "isotope-queue-dlq-staging"
          }
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "isotope-db",
          "database_id": "ade49f6b-b66a-4f50-9cf0-2f32f8974a6f",
          "migrations_dir": "../../src/db/migrations",
          "remote": true
        }
      ]
    },
    "production": {
      "name": "isotope-processor",
      "queues": {
        "consumers": [
          {
            "queue": "isotope-queue",
            "max_batch_size": 10,
            "max_batch_timeout": 30,
            "max_retries": 3,
            "dead_letter_queue": "isotope-queue-dlq"
          }
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "isotope-db",
          "database_id": "ade49f6b-b66a-4f50-9cf0-2f32f8974a6f",
          "migrations_dir": "../../src/db/migrations",
          "remote": true
        }
      ]
    }
  }
}
